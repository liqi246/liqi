#线索创建时段分布
df_clean['小时'] = df_clean['线索创建时间'].dt.hour
hourly = df_clean.groupby('小时').agg(
    线索数=('线索ID','count'),
    高意向数 = ('是否高意向','sum'))
hourly['高意向率'] = (hourly['高意向数'] / hourly['线索数'] * 100).round(1)
print(hourly)
fig,ax1 = plt.subplots(figsize=(10,5))
width = 0.35
ax1.bar(hourly.index,hourly['线索数'],width,color = '#a6cee3',label = '总线索数')
ax1.set_label('小时')
ax1.set_ylabel('线索数',color='#a6cee3')
ax1.tick_params(axis = 'y',labelcolor = '#a6cee3')

ax2 = ax1.twinx()
ax2.plot(hourly.index,hourly['高意向率'],'o-',width,color = '#e31a1c',linewidth=2,label = '高意向率')
ax2.set_ylabel('高意向率%',color='#e31a1c')
